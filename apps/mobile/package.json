{
  "name": "@app/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:android": "node scripts/dev-native.ts android",
    "dev:ios": "node scripts/dev-native.ts ios",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "cap:sync": "vite build && cap sync",
    "cap:android": "vite build && cap sync android && cap open android",
    "cap:ios": "vite build && cap sync ios && cap open ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@app/platform": "workspace:*",
    "@app/ui": "workspace:*",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
